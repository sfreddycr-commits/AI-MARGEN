# Copiar a .env y completar. Nunca hacer commit de .env.
# En producción, estas variables se definen en el servidor (ver docs/deploy/produccion.md).

# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=info
# Versión mostrada en /health (el pipeline de despliegue la fija con el SHA del commit)
APP_VERSION=

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# URL pública de la web (enlaces de los correos)
APP_URL=http://localhost:5173
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (MySQL 8) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aimargen
DB_PASSWORD=aimargen_local
DB_NAME=aimargen_dev
DB_POOL_SIZE=10
# Base usada por pruebas de integración (se recrea en cada corrida)
DB_NAME_TEST=aimargen_test

# --- Sesión ---
# Obligatorio en staging/producción (≥ 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Cookies Secure (por defecto true en staging/producción)
COOKIE_SECURE=

# --- Correo transaccional ---
# 'log' = desarrollo (no envía; ver /api/v1/dev/outbox con DEV_OUTBOX=true). Producción: 'smtp'.
MAIL_DRIVER=log
MAIL_FROM=AImargen <no-reply@aimargen.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
DEV_OUTBOX=true

# --- Archivos (facturas) ---
# 'local' (carpeta del servidor) o 's3' (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_MB=10

# --- IA ---
# 'none' desactiva la IA (el resto de AImargen funciona). 'anthropic' requiere ANTHROPIC_API_KEY.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Costo estimado por millón de tokens (USD) para el registro de consumo. Ajustar al precio vigente.
AI_COST_INPUT_PER_MTOK=3
AI_COST_OUTPUT_PER_MTOK=15
# Límite mensual de solicitudes de IA por negocio (0 = sin límite)
AI_MONTHLY_LIMIT=500

# --- Seguridad y observabilidad ---
RATE_LIMIT_MAX=300
# Token para GET /api/v1/metrics (Prometheus). Vacío = /metrics oculto en producción.
METRICS_TOKEN=
# Documentación OpenAPI en /api/docs (por defecto desactivada en producción)
API_DOCS=

# --- Web ---
VITE_API_BASE_URL=/api/v1
