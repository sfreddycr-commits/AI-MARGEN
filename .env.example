# Copiar a .env y completar. Nunca hacer commit de .env.

# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (MySQL 8) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aimargen
DB_PASSWORD=aimargen_local
DB_NAME=aimargen_dev
# Base usada por pruebas de integración (se recrea en cada corrida)
DB_NAME_TEST=aimargen_test

# --- Redis (opcional en local) ---
REDIS_URL=

# --- Auth (Etapa 3) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
COOKIE_SECRET=

# --- IA (Etapa 11) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Web ---
VITE_API_BASE_URL=/api/v1
